# ═══════════════════════════════════════════════════════════
# روليت تيك توك لايف - متغيرات البيئة
# ═══════════════════════════════════════════════════════════

# Port (Railway/Render sets this automatically)
PORT=3001

# مجلد حفظ بيانات اللعبة والسجلات (افتراضي: ./data)
# DATA_DIR=./data

# Your Vercel/GitHub Pages frontend URL (set this on the backend host)
# Example: https://gamvora.github.io
FRONTEND_URL=https://your-app.vercel.app

# Optional: EulerStream API key for direct TikTok Live connection
# Get it free from: https://www.eulerstream.com/
# Without this, use TikFinity webhook mode instead
EULER_API_KEY=

# Node environment
NODE_ENV=production
